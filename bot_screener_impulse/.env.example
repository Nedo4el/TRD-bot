# ============================================================
# Скринер импульсов — обнаружение резких ценовых движений
# ============================================================

# ============ Bybit API ключи ============
BYBIT_API_KEY=YOUR_API_KEY
BYBIT_API_SECRET=YOUR_API_SECRET
TESTNET=true

# ============ Режим сканирования ============
TIMEFRAME=5
SCAN_INTERVAL=15
MIN_TURNOVER_24H=500000
LOOKBACK_BARS=50

# ============ Основные параметры ============
# Минимальный % импульса (свеча выросла/упала на N%)
MIN_IMPULSE_PERCENT=0.5
# Во сколько раз свеча должна быть длиннее средней
RANGE_MULTIPLIER=2.5
# Во сколько раз объём выше среднего
VOLUME_MULTIPLIER=2.0
# Период расчёта средних
PERIOD=20

# ============ Фильтры шума ============
# Минимальный объём торгов в USD
MIN_VOLUME_USD=500000
# Максимальный спред %
MAX_SPREAD_PERCENT=0.05
# Минимальный body % (тело свечи от high-low)
MIN_BODY_PERCENT=60
# Минимальное кол-во сделок
MIN_TRADES=1000
# Максимальный ATR% (выше = слишком волатильно)
MAX_ATR_PERCENT=2.0
# Кулдаун между сигналами (сек)
COOLDOWN_SECONDS=300

# ============ Исключения ============
EXCLUDE_SYMBOLS=BTCUSDT,ETHUSDT,BNBUSDT,SOLUSDT,XRPUSDT,DOGEUSDT,ADAUSDT,AVAXUSDT,DOTUSDT,LINKUSDT,TRXUSDT,TONUSDT,SUIUSDT
