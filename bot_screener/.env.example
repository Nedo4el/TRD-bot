# ============================================================
# Скринер точек прорыва — Bybit USDT-M фьючерсы
# ============================================================

# ============ Bybit API ключи ============
BYBIT_API_KEY=YOUR_API_KEY
BYBIT_API_SECRET=YOUR_API_SECRET
TESTNET=true

# ============ Режим сканирования ============
TIMEFRAMES=1,5
SCAN_INTERVAL=60
MIN_TURNOVER_24H=5000000

# ============ Объём ============
VOLUME_SPIKE=1.3
VOLUME_DROP_BEFORE=0.8

# ============ Индикаторы (бонусы к скору) ============
BBW_THRESHOLD=0.05
ADX_THRESHOLD=15
RSI_LONG=50
RSI_SHORT=50

# ============ Периоды индикаторов ============
EMA_PERIOD=20
RSI_PERIOD=14
ADX_PERIOD=14
ATR_PERIOD=14
BB_PERIOD=20
VOLUME_MA_PERIOD=20

# ============ Лимиты API ============
API_DELAY_MS=50
KLINE_LIMIT=100
