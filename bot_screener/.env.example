# ============================================================
# Скринер точек прорыва — Bybit USDT-M фьючерсы
# ============================================================

# ============ Bybit API ключи ============
BYBIT_API_KEY=YOUR_API_KEY
BYBIT_API_SECRET=YOUR_API_SECRET
TESTNET=true

# ============ Режим сканирования ============
# Таймфреймы через запятую (сканируем все)
TIMEFRAMES=1,5
# Интервал сканирования (секунды)
SCAN_INTERVAL=60
# Минимальный оборот за 24ч в USD
MIN_TURNOVER_24H=5000000

# ============ Параметры прорыва ============
# Период для поиска максимума/минимума (свечей)
BREAKOUT_PERIOD=20
# Буфер прорыва (ATR × множитель)
ATR_BUFFER=0.15
# Текущий объём > среднего в X раз
VOLUME_SPIKE=1.8
# Объём перед сигналом < среднего в X раз
VOLUME_DROP_BEFORE=0.7
# Ширина полос Боллинджера < порога
BBW_THRESHOLD=0.03

# ============ Фильтры тренда ============
# ADX > порог = тренд достаточно сильный
ADX_THRESHOLD=25
# RSI для лонга (выше = подтверждение тренда вверх)
RSI_LONG=55
# RSI для шорта (ниже = подтверждение тренда вниз)
RSI_SHORT=45

# ============ Индикаторы ============
# Период EMA для определения тренда
EMA_PERIOD=20
# Период RSI
RSI_PERIOD=14
# Период ADX
ADX_PERIOD=14
# Период ATR
ATR_PERIOD=14
# Период Bollinger Bands
BB_PERIOD=20
# Скользящее среднее объёма
VOLUME_MA_PERIOD=20

# ============ Лимиты API ============
# Задержка между запросами (мс) — защита от банов
API_DELAY_MS=50
# Сколько свечей запрашивать
KLINE_LIMIT=100
