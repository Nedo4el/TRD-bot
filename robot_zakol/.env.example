BYBIT_API_KEY=
BYBIT_API_SECRET=
TESTNET=false

SYMBOL=BTCUSDT
CATEGORY=linear
DEPOSIT_USD=100
QTY=0
POSITION_PCT=18      # сетка из 3 ордеров: POSITION_PCT/3 на ордер (>= $5 min_notional)

LONG_ONLY=false        # false = бракет: лонги вниз + шорты вверх
GRID_PCTS=0.02,0.03,0.05  # уровни сетки: лонги -2/-3/-5%, шорты +2/+3/+5% от цены
OFFSET_PCT=0.03        # live-брекет (order_cycle) до переписки на сетку
TTL_SEC=10             # жизнь сетки, сек (резкий подход — 10 сек)
MIN_PRICE_CHANGE=0.003
STOP_DELAY_SEC=10      # стоп выставляется через N сек после входа (0 = сразу от входа)

STOP_PCT=0.01         # стоп через задержку: 1% от текущей цены
TAKE_PCT=0.015        # тейк-зона 1.5%
TRAIL_PCT=0.003       # трейлинг-тейк 0.3% от пика (в зоне тейка)
BE_TRIGGER=0.005      # безубыток после +0.5% от входа
BE_OFFSET=0.005       # уровень безубытка = вход +0.5%
MAX_LOSS_USD=10
MAX_DRAWDOWN_PCT=0.05
PARTIAL_FILL_PCT=0
MAX_CONCURRENT=1

REQUESTS_PER_SECOND=100
WS_ENABLED=true
LOG_LEVEL=INFO
LOG_FILE=logs/zakol.log
STATE_FILE=data/zakol_state.json

# === Надёжность ===
SLIPPAGE_PCT=0.005      # допуск на отклонение цены при re-place, доля (0 = выкл)
COOLDOWN_SEC=0          # пауза после стопа/тейка, сек (0 = выкл)
DAILY_LOSS_LIMIT=0      # дневной стоп-кран по убытку, USD (0 = выкл)
MAX_TRADES_PER_DAY=0    # максимум закрытий за сутки UTC (0 = выкл)
RECONNECT_SEC=2         # база экспоненциального backoff WS, сек
HEARTBEAT_SEC=1         # период проверки живости WS, сек
RECV_WINDOW=10000       # окно валидности подписи, мс
TIME_SYNC=true          # сверка часов с Bybit (лечение retCode 10002)
KILL_SWITCH=data/zakol.kill  # файл-флаг ручной остановки (пусто = выкл)
ORDER_LINK_ID_PREFIX=zk-     # префикс orderLinkId, 1..17 символов
FUNDING_AWARE=false     # не входить в окно до фандинга (perpetual)
FUNDING_WINDOW_SEC=60   # окно запрета входа перед фандингом, сек
