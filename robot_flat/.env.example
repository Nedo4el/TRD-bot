# === Bybit API ===
BYBIT_API_KEY=
BYBIT_API_SECRET=
TESTNET=false

# === Инструмент ===
SYMBOL=BRUSDT
CATEGORY=linear
TIMEFRAME=5

# === Размер позиции ===
DEPOSIT_USD=100
QTY=0
POSITION_PCT=10

# === Свечи ===
CANDLE_WARMUP=300               # закрытых свечей для решений (5м)
POLL_SEC=10

# === Устойчивость / подпись ===
REQUESTS_PER_SECOND=100
WS_ENABLED=true
ORDER_LINK_ID_PREFIX=fl-

# === Kill-switch / гейты входа ===
KILL_SWITCH=data/flat.kill      # создать файл = мгновенная остановка (пусто = выкл.)
MAX_LOSS_USD=10                 # убыток сессии до kill, USD (0 = выкл.)
MAX_DRAWDOWN_PCT=0.05           # просадка equity от пика до kill (0 = выкл.)
SLIPPAGE_PCT=0.005              # допуск цена WS vs REST при входе (0 = выкл.)
COOLDOWN_SEC=15                 # пауза после закрытия позиции, сек (0 = выкл.)
DAILY_LOSS_LIMIT=0              # дневной стоп-кран по убытку, USD (0 = выкл.)
MAX_TRADES_PER_DAY=0            # максимум сделок в сутки UTC (0 = выкл.)
FUNDING_AWARE=true              # не входить в окно перед финансированием
FUNDING_WINDOW_SEC=60           # окно финансирования до события, сек

# === WS / подпись запросов ===
RECONNECT_SEC=2                 # база экспоненциального backoff WS, сек
HEARTBEAT_SEC=1                 # период проверки живости WS, сек
RECV_WINDOW=10000               # окно приёма ответа Bybit, мс
TIME_SYNC=true                  # сверка часов с Bybit (лечит retCode 10002)

# === Логи / состояние ===
LOG_LEVEL=INFO
LOG_FILE=logs/flat.log
STATE_FILE=data/flat_state.json

# ============================================================
#   СТРАТЕГИЯ v3 — сетка вокруг POC в VA-диапазоне (M5)
# ============================================================
POC_WINDOW_MIN=30             # окно профиля: последние 30 минут (6×M5)
POC_REFRESH_MIN=60            # пересчёт POC/VA каждый час (rolling)
VALUE_AREA_PCT=0.7            # value area = 70% объёма профиля
PROFILE_BINS=100              # бинов volume profile
ADX_PERIOD=14                 # окно ADX
ADX_THRESHOLD=25.0            # ADX >= порога → тренд, входов нет
GRID_LEVELS=3                 # уровней на сторону (секторы от VA до middle)
MIDDLE_PCT=0.5                # запрет: 50% ширины VA вокруг POC
BREAKOUT_PCT=0.05             # SL = граница VA ± 5% цены
BREAKOUT_RETURN_MIN=10        # гвард: вне диапазона > 10м → халт + POC
TP_OFFSET_PCT=0.01            # TP2 = обратная сетка − 1% к POC
TP_SPLIT=0.5                  # 50% позиции на POC, 50% на TP2
BE_TRIGGER_PCT=0.03           # безубыток после +3% от входа
