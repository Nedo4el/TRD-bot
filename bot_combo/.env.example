# ============================================================
# Бот: Комбинированный фильтр: EMA(21/50) + RSI(14) + Bollinger(20,2).
# Скальпинг на M1. TP 0.5%, SL 0.3%, фиксированный лот.
# ============================================================

# ============ Bybit API ключи ============
BYBIT_API_KEY=your_api_key_here
BYBIT_API_SECRET=your_api_secret_here
# Тестовая сеть (true = testnet, false = mainnet)
TESTNET=true

# Режим симуляции: true - бот НЕ отправляет реальные ордера,
# только логирует, что бы сделал. Безопасно для отладки.
SIMULATION_MODE=true

# Рыночная категория: linear (USDT-фьючерсы) | spot
CATEGORY=linear

# Торговая пара
SYMBOL=XRPUSDT

# Таймфрейм свечей: 1 | 5 | 15 | 60 | 240 | D
TIMEFRAME=1

# Интервал проверки сигналов (секунды)
POLL_INTERVAL=60

# Сколько свечей запрашивать для расчёта индикаторов
KLINE_LIMIT=200

# Максимум REST-запросов в секунду (защита от лимитов Bybit)
REQUESTS_PER_SECOND=10

# ============ Риск-менеджмент ============
# Размер позиции в % от доступного баланса
POSITION_PCT=10.0

# Фиксированный размер лота в базовом активе.
# 0 = выключено (размер считается от POSITION_PCT).
FIXED_QTY=0.01

# Стоп-лосс и тейк-профит в % от цены входа.
# ВНИМАНИЕ: для этого бота проценты из спецификации (TP 0.5% / SL 0.3%).
STOP_LOSS_PCT=0.3
TAKE_PROFIT_PCT=0.5

# ============ WebSocket ============
WS_ENABLED=true

# ============ Telegram уведомления ============
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ============ Логирование ============
LOG_LEVEL=INFO
LOG_FILE=logs/combo.log
STATE_FILE=data/state_combo.json

# ============ Параметры стратегии Combo ============
# Периоды EMA для определения тренда
EMA_FAST_PERIOD=21
EMA_SLOW_PERIOD=50

# RSI: период и уровни зон перепроданности/перекупленности
RSI_PERIOD=14
RSI_OVERSOLD=30
RSI_OVERBOUGHT=70

# Полосы Боллинджера: период и число стандартных отклонений
BB_PERIOD=20
BB_DEVIATION=2.0
