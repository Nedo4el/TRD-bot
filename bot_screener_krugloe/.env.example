# ============================================================
# Скринер круглых чисел — Bybit USDT-M фьючерсы
# ============================================================

# ============ Bybit API ключи ============
BYBIT_API_KEY=
BYBIT_API_SECRET=
TESTNET=false

# ============ Режим сканирования ============
TIMEFRAME=5
SCAN_INTERVAL=300
MIN_TURNOVER_24H=10000000
PROXIMITY_PCT=5
MAX_PRICE=0

# ============ Исключения ============
EXCLUDE_SYMBOLS=BTCUSDT,ETHUSDT,BNBUSDT,SOLUSDT,XRPUSDT,DOGEUSDT,ADAUSDT,AVAXUSDT,DOTUSDT,LINKUSDT,TRXUSDT,TONUSDT,SUIUSDT,SHIBUSDT,LTCUSDT
