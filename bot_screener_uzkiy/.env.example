# ============================================================
#   — Новый скринер
# ============================================================

# ============ Bybit API ключи ============
BYBIT_API_KEY=YOUR_API_KEY
BYBIT_API_SECRET=YOUR_API_SECRET
TESTNET=true

# ============ Режим сканирования ============
TIMEFRAME=D
SCAN_INTERVAL=3600
MIN_TURNOVER_24H=1000000
LOOKBACK_BARS=100

# ============ Исключения ============
EXCLUDE_SYMBOLS=BTCUSDT,ETHUSDT
