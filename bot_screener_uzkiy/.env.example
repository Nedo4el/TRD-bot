# ============================================================
# Скринер сужения диапазона — Скальпинг Bybit USDT-M
# ============================================================

# ============ Bybit API ключи ============
BYBIT_API_KEY=YOUR_API_KEY
BYBIT_API_SECRET=YOUR_API_SECRET
TESTNET=true

# ============ Режим сканирования ============
# TIMEFRAMES=1,3,5
# SCAN_INTERVAL=10
# MIN_TURNOVER_24H=10000000
# LOOKBACK_BARS=50
# MIN_SCORE=40

# ============ Спред ============
# SPREAD_MAX_PCT=0.05

# ============ Pattern: Extrema ============
# EXTREMA_WINDOW=5

# ============ Pattern: Наклоны (% от цены за свечу) ============
# SLOPE_UP=0.3
# SLOPE_DOWN=-0.3
# SLOPE_FLAT=0.1

# ============ Pattern: Сжатие ============
# COMPRESSION_RATIO=0.75
# TRIANGLE_LOOKBACK=30

# ============ Pattern: BB ============
# BB_LOOKBACK=20
# BB_PERIOD=20
# BB_DEV=2.0

# ============ Pattern: ATR ============
# ATR_LOOKBACK=10
# ATR_DROP_THRESHOLD=0.3
# ATR_PERIOD=14

# ============ Pattern: ADX ============
# ADX_FALSE_THRESHOLD=20
# ADX_STRONG_THRESHOLD=25
# ADX_PERIOD=14

# ============ Исключения ============
# EXCLUDE_SYMBOLS=BTCUSDT,ETHUSDT
