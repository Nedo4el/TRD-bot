# ============================================================
# Volume Profile скринер — Bybit USDT-M фьючерсы
# ============================================================

# ============ Bybit API ключи ============
BYBIT_API_KEY=YOUR_API_KEY
BYBIT_API_SECRET=YOUR_API_SECRET
TESTNET=true

# ============ Режим сканирования ============
TIMEFRAMES=5
SCAN_INTERVAL=300
MIN_TURNOVER_24H=50000000

# ============ Volume Profile ============
LOOKBACK_BARS=500
NUM_LEVELS=10
NUM_BINS=100
PROXIMITY_PCT=5.0

# ============ Исключения ============
EXCLUDE_SYMBOLS=BTCUSDT,ETHUSDT,BNBUSDT,SOLUSDT,XRPUSDT,DOGEUSDT,ADAUSDT,AVAXUSDT,DOTUSDT,LINKUSDT
