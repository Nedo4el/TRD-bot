# === Bybit API ===
BYBIT_API_KEY=
BYBIT_API_SECRET=
TESTNET=false

# === Инструмент ===
SYMBOL=BTCUSDT
CATEGORY=linear
TIMEFRAME=15

# === Размер позиции ===
DEPOSIT_USD=100
QTY=0
POSITION_PCT=10

# === Свечи ===
CANDLE_WARMUP=300               # свечей рабочего ТФ (15м) в запросе
POLL_SEC=10
HTF_TIMEFRAME=60                # старший ТФ, минуты (направление + сила тренда)
HTF_WARMUP=250                  # свечей старшего ТФ (>= EMA_MACRO + 2)

# === Исполнение ===
REQUESTS_PER_SECOND=100
WS_ENABLED=true
ORDER_LINK_ID_PREFIX=tr-

# === Защита ===
KILL_SWITCH=data/trend.kill   # файл-флаг ручной остановки (пусто = выкл)
MAX_LOSS_USD=10               # дневной стоп по убытку сессии, USD (0 = выкл)
MAX_DRAWDOWN_PCT=0.05         # просадка equity от депозита до kill (0 = выкл)
SLIPPAGE_PCT=0.005            # допуск расхождения фида и REST, доля (0 = выкл)
COOLDOWN_SEC=15               # пауза после закрытия позиции, сек (0 = выкл)
DAILY_LOSS_LIMIT=0            # дневной стоп-кран по убытку, USD (0 = выкл)
MAX_TRADES_PER_DAY=0          # максимум закрытий за сутки UTC (0 = выкл)
FUNDING_AWARE=true            # не входить в окно до фандинга (perpetual)
FUNDING_WINDOW_SEC=60         # окно запрета входа перед фандингом, сек

# === Устойчивость WS / подпись запросов ===
RECONNECT_SEC=2               # база экспоненциального backoff WS, сек
HEARTBEAT_SEC=1               # период проверки живости WS, сек
RECV_WINDOW=10000             # окно валидности подписи, мс
TIME_SYNC=true                # сверка часов с Bybit (лечение retCode 10002)

# === Логи / состояние ===
LOG_LEVEL=INFO
LOG_FILE=logs/trend.log
STATE_FILE=data/trend_state.json

# ============================================================
#   СТРАТЕГИЯ: мульти-ТФ — 60м режим / 15м триггер (сетка 2026-10-04: 5/5 альтов)
#   60м: EMA + ADX/DI — направление и сила тренда (куда входить).
#   15м: разворот Supertrend + объём — момент входа.
#   Выход: разворот Supertrend на 15м (SL/TP — страховка).
# ============================================================

# --- EMA (60м): направление тренда ---
EMA_FAST=20                    # быстрая EMA
EMA_SLOW=50                    # средняя EMA
EMA_MACRO=200                  # макро-фильтр: цена должна быть по ту сторону

# --- ADX (+DI/-DI) (60м): сила тренда / допустимая сторона ---
ADX_PERIOD=14
ADX_THRESHOLD=25               # ниже порога — флэт, входа нет

# --- Supertrend (15м): триггер входа + трейлинг-стоп ---
ST_ATR_PERIOD=10               # альты: период ATR
ST_FACTOR=3.0                  # альты: множитель полосы
ST_ATR_PERIOD_MAJOR=55         # BTC/ETH: период ATR
ST_FACTOR_MAJOR=2.0            # BTC/ETH: множитель полосы
# профиль выбирается автоматически по SYMBOL

# --- Риск: SL/TP + безубыток + трейлинг (% от входа) ---
SL_PCT=0.02                  # стоп: -2% от входа
TP_PCT=0.05                  # тейк: +5% от входа
BE_TRIGGER=0.02              # BE и трейлинг включаются после +2%
BE_OFFSET=0                  # уровень BE = цена входа (+ offset)
TRAIL_PCT=0.02               # трейлинг: стоп = пик - 2%

# --- Volume SMA (15м): подтверждение пробоя ---
VOL_PERIOD=20
VOL_MULT=1.3                   # объём сигнальной свечи >= 1.3 x SMA
