# === Bybit API ===
BYBIT_API_KEY=
BYBIT_API_SECRET=
TESTNET=false

# === Инструмент ===
SYMBOL=BTCUSDT
CATEGORY=linear
TIMEFRAME=5

# === Размер позиции ===
DEPOSIT_USD=100
QTY=0
POSITION_PCT=6

# === Свечи ===
CANDLE_WARMUP=300               # свечей рабочего ТФ (5м) в запросе
POLL_SEC=10
WAKE_JITTER_MS=3000             # разброс REST-тика, мс (случайный на процесс)
HTF_TIMEFRAME=60                # старший ТФ, минуты (направление + сила тренда)
HTF_WARMUP=250                  # свечей старшего ТФ (>= EMA_MACRO + 2)

# === Исполнение ===
REQUESTS_PER_SECOND=100
WS_ENABLED=true
ORDER_LINK_ID_PREFIX=tr-

# === Защита ===
KILL_SWITCH=data/trend.kill   # файл-флаг ручной остановки (пусто = выкл)
MAX_LOSS_USD=10               # kill-switch по убытку сессии, USD (0 = выкл)
MAX_DRAWDOWN_PCT=0.05         # просадка equity от депозита до kill (0 = выкл)
SLIPPAGE_PCT=0.005            # допуск расхождения фида и REST, доля (0 = выкл)
COOLDOWN_SEC=300              # пауза после закрытия позиции, сек (0 = выкл)
DAILY_LOSS_LIMIT=10           # дневной стоп-кран по убытку, USD (0 = выкл)
MAX_TRADES_PER_DAY=50         # максимум закрытий за сутки UTC (0 = выкл)
FUNDING_AWARE=true            # не входить в окно до фандинга (perpetual)
FUNDING_WINDOW_SEC=60         # окно запрета входа перед фандингом, сек

# === Устойчивость WS / подпись запросов ===
RECONNECT_SEC=2               # база экспоненциального backoff WS, сек
HEARTBEAT_SEC=1               # период проверки живости WS, сек
RECV_WINDOW=10000             # окно валидности подписи, мс
TIME_SYNC=true                # сверка часов с Bybit (лечение retCode 10002)

# === Логи / состояние ===
LOG_LEVEL=INFO
LOG_FILE=logs/trend.log
STATE_FILE=data/trend_state.json

# ============================================================
#   СТРАТЕГИЯ: тренд на откате к EMA (без Supertrend)
#   HTF (60м): EMA + ADX/DI — направление и сила тренда.
#   LTF (5м): откат к EMA_FAST + объём — точка входа.
#   Выход: стоп 3% и фиксированный тейк 10% (BE/трейлинг выключены).
# ============================================================

# --- EMA: направление тренда (HTF) и откат (LTF) ---
EMA_FAST=23                    # быстрая EMA (к ней ждём откат)
EMA_SLOW=50                    # средняя EMA
EMA_MACRO=200                  # макро-фильтр: цена должна быть по ту сторону
EMA_MIN_SPREAD_PCT=0.1         # мин. зазор EMA_FAST/EMA_SLOW, % (фильтр боковика)
ENTRY_ON_PULLBACK=true         # вход на откате к EMA_FAST, а не на пересечении

# --- ADX (+DI/-DI) (HTF): сила тренда / допустимая сторона ---
ADX_PERIOD=14
ADX_THRESHOLD=30               # ниже порога — флэт, входа нет

# --- Риск: стоп 3%, безубыток +1% после +5%, трейлинг 2% с +9%, тейк 15% ---
SL_PCT=0.03                    # стоп: -3% от входа
TAKE_PCT=0.15                  # фиксированный тейк: +15% (0 = выключен)
BE_TRIGGER=0.05                # прибыль, после которой стоп уходит в безубыток
BE_OFFSET=0.01                 # уровень BE = цена входа (+1%)
TRAIL_PCT=0.02                 # отступ трейлинга от пика (0 = выключен)
TRAIL_TRIGGER=0.09             # пик, с которого включается трейлинг (0 = вместе с BE)

# --- Volume SMA (LTF): подтверждение входа ---
VOLUME_SMA_PERIOD=20
VOLUME_MULTIPLIER=1.0          # 1.0 = фильтр выключен (объём любой)


# --- Guard: защита открытой позиции (CVD-дивергенция, absorption, OI) ---
GUARD_ENABLED=true             # выключатель всех трёх модулей
GUARD_DRY_RUN=true             # true = только сигналы в лог, без ордеров
CVD_ENABLED=true
CVD_WINDOW=30                  # окно дивергенции, свечей 5м
CVD_EXIT_MODE=partial          # partial = закрыть половину, full = выйти целиком
CVD_PARTIAL_PCT=0.5            # доля закрытия при partial (уровень и сигнал)
PARTIAL_MODE=both              # level = только уровень, signal = только guard, both = кто раньше
PARTIAL_MIN_PROFIT=0.05        # сигнал режет только если позиция в плюсе на 5%
PARTIAL_FALLBACK_PCT=0.12      # уровень-предохранитель (ниже TAKE_PCT!), 0 = выкл
PARTIAL_SIGNAL=cvd+oi          # какие модули дают право на partial: cvd+oi / cvd / oi / any
ABSORPTION_ENABLED=true
ABSORPTION_VOL_MULT=2.0        # объём >= 2x среднего за 20 свечей
ABSORPTION_BODY_MAX=0.3        # тело <= 30% ATR(14) = "объём без движения"
OI_ENABLED=true
OI_WINDOW=30                   # окно роста цены для OI-дивергенции
OI_DROP_PCT=0.03               # OI упал на 3% от пика = денег не добавилось
FUNDING_HIGH_THRESHOLD=0.0005  # фандинг >= 0.05% = перегрев, выходим целиком
MIN_VOLUME_USD=100000          # ниже оборота свечи guard не срабатывает