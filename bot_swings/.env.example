# ============================================================
# Бот: Свинг-уровни: пробой уровня + ретест.
# Уровни ищутся по локальным максимумам/минимумам,
# TP 0.4%, SL 0.2%.
# ============================================================

# ============ Bybit API ключи ============
BYBIT_API_KEY=your_api_key_here
BYBIT_API_SECRET=your_api_secret_here
# Тестовая сеть (true = testnet, false = mainnet)
TESTNET=true

# Режим симуляции: true - бот НЕ отправляет реальные ордера,
# только логирует, что бы сделал. Безопасно для отладки.
SIMULATION_MODE=true

# Рыночная категория: linear (USDT-фьючерсы) | spot
CATEGORY=linear

# Торговая пара
SYMBOL=XRPUSDT

# Таймфрейм свечей: 1 | 5 | 15 | 60 | 240 | D
TIMEFRAME=5

# Интервал проверки сигналов (секунды)
POLL_INTERVAL=30

# Сколько свечей запрашивать для расчёта индикаторов
KLINE_LIMIT=200

# Максимум REST-запросов в секунду (защита от лимитов Bybit)
REQUESTS_PER_SECOND=10

# ============ Риск-менеджмент ============
# Размер позиции в % от доступного баланса
POSITION_PCT=10.0

# Фиксированный размер лота в базовом активе.
# 0 = выключено (размер считается от POSITION_PCT).
FIXED_QTY=0

# Стоп-лосс и тейк-профит в % от цены входа.
# ВНИМАНИЕ: для этого бота проценты из спецификации (TP 0.4% / SL 0.2%).
STOP_LOSS_PCT=0.2
TAKE_PROFIT_PCT=0.4

# ============ WebSocket ============
WS_ENABLED=true

# ============ Telegram уведомления ============
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ============ Логирование ============
LOG_LEVEL=INFO
LOG_FILE=logs/swings.log
STATE_FILE=data/state_swings.json

# ============ Параметры стратегии Swings ============
# Глубина истории для поиска уровней (свечей)
LOOKBACK_CANDLES=50

# Свинг: High/Low выше/ниже N соседей слева И справа
WING_SIZE=5

# Сколько последних уровней хранить в памяти
MAX_LEVELS=5

# Если ретест не случился за столько свечей после пробоя - сетап отменяется
RETEST_MAX_BARS=20
