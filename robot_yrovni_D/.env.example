# ============================================================
#   Robot Yrovni D — торговля POC-уровнями (TEMPLATE)
#   Скопируйте в .env и впишите ключи.
# ============================================================

# --- Bybit ---------------------------------------------------
BYBIT_API_KEY=your_key
BYBIT_API_SECRET=your_secret
TESTNET=true
CATEGORY=linear
# true — PaperBook-симуляция, реальные ордера НЕ отправляются.
DRY_RUN=true

# --- Депозит и размер позиции --------------------------------
DEPOSIT_USD=100
POSITION_PCT=6
# Доли трёх лимиток; сумма = 1.0
ORDER_SPLIT=0.33,0.34,0.33

# --- Вход ----------------------------------------------------
# Отступ лимиток от POC: 51% / 50% / 49% при 0.02
LEVEL_OFFSET_PCT=0.02
# Жизнь невыполненных лимиток, сек
ENTRY_TTL_SEC=43200
# Отмена всех лимиток, если цена ушла от POC дальше этой доли
CANCEL_IF_DISTANCE_PCT=0.15

# --- Стоп ----------------------------------------------------
STOP_INITIAL_PCT=0.10
BE_TRIGGER_PCT=0.01
BE_OFFSET_PCT=0.0
CANCEL_LIMITS_ON_BE=true

# --- Тейк и трейлинг ----------------------------------------
TAKE_PCT=0.07
TRAIL_PCT=0.03
TRAIL_ACTIVATE_PCT=0.07

# --- Фильтры входа ------------------------------------------
MIN_CONFIDENCE=0.6
MAX_CONCURRENT=1
COOLDOWN_SEC=900
MAX_HOLD_SEC=86400
# ATR(5m) как доля цены; 0 — фильтр выключен
MAX_ATR_PCT=0.02
MAX_DISTANCE_FROM_POC_PCT=0.15
FUNDING_WINDOW_SEC=300
ATR_PERIOD=14
ATR_TIMEFRAME=5

# --- Логи JSONL ---------------------------------------------
LOG_FILE=logs/strategy.jsonl
LOG_ROTATION_MB=50
LOG_KEEP_DAYS=7
TICK_SNAPSHOT_SEC=60
BOT_LOG_FILE=logs/robot_yrovni_D.log
LOG_LEVEL=INFO

# --- Источники сигналов -------------------------------------
# Входящие POST /api/signal и /api/poc-signal
SIGNAL_HOST=127.0.0.1
SIGNAL_PORT=8789
# Поллинг активных сигналов дашборда; 0 — выключить
DASHBOARD_URL=http://127.0.0.1:8787
SIGNAL_POLL_SEC=2
POLL_TIMEOUT_SEC=5

# --- Инфраструктура -----------------------------------------
TICK_SEC=5
REQUESTS_PER_SECOND=10
KILL_SWITCH=data/robot_yrovni_D.kill
PROCESSED_FILE=data/robot_yrovni_D_processed.json
# Состояние открытой позиции (переживает рестарт, его читает дашборд)
STATE_FILE=data/robot_yrovni_D_state.json
ORDER_LINK_ID_PREFIX=zk-
# Самодиагностика при старте: скан старых ордеров и позиции по символу
STARTUP_CHECK=true
# Снимать свои старые ордера (префикс ORDER_LINK_ID_PREFIX), если позиции нет
STARTUP_CLEANUP=true
# Разрешать заново активные сигналы, до уровня которых цена ещё не дошла
STARTUP_REARM=true
# Брать существующую позицию под управление при старте (state/свои ордера)
STARTUP_ADOPT=true

# Per-symbol override (JSON в одну строку), например для альтов:
# SYMBOL_OVERRIDES={"AKEUSDT": {"stop_initial_pct": 0.15, "level_offset_pct": 0.03}}
