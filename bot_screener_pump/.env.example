# ============================================================
# Accumulation скринер — поиск накопления крупных игроков
# ============================================================

# ============ Bybit API ключи ============
BYBIT_API_KEY=YOUR_API_KEY
BYBIT_API_SECRET=YOUR_API_SECRET
TESTNET=true

# ============ Режим сканирования ============
TIMEFRAME=D
SCAN_INTERVAL=3600
MIN_TURNOVER_24H=1000000
LOOKBACK_BARS=100
MIN_PROBABILITY=0.0

# ============ Периоды анализа ============
ANALYSIS_PERIOD=100
VOLUME_LOOKBACK=20
OBV_LOOKBACK=30
BB_PERIOD=20
BB_DEV=2.0
RSI_PERIOD=14
SMART_MONEY_LOOKBACK=7

# ============ Пороги (отключены) ============
RANGE_MAX=999.0
RANGE_MIN=0.0
VOLUME_SPIKE=0.0
BB_COMPRESSION=999.0
MIN_VOLUME_USD=0.0
MIN_TRADES=0
MAX_SPREAD=999.0
MIN_DAYS_LISTED=0
MAX_PRICE=0.03
MIN_TOTAL_VOLUME_USD=50000000

# ============ Фильтры шума (отключены) ============
MAX_VOLATILITY_3D=999.0
MAX_DROP_7D=999.0
MIN_PUMP_PROBABILITY=0.0

# ============ Веса факторов (обнулены) ============
WEIGHT_RANGE=0.0
WEIGHT_VOLUME=0.0
WEIGHT_OBV=0.0
WEIGHT_BB=0.0
WEIGHT_SMART_MONEY=0.0
WEIGHT_OUTFLOW=0.0
WEIGHT_RSI=0.0
WEIGHT_LIQUIDITY=0.0

# ============ Исключения ============
EXCLUDE_SYMBOLS=BTCUSDT,ETHUSDT,BNBUSDT,SOLUSDT,XRPUSDT,DOGEUSDT,ADAUSDT,AVAXUSDT,DOTUSDT,LINKUSDT
