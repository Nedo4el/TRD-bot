# ============================================================
# Accumulation скринер — поиск накопления крупных игроков
# ============================================================

# ============ Bybit API ключи ============
BYBIT_API_KEY=YOUR_API_KEY
BYBIT_API_SECRET=YOUR_API_SECRET
TESTNET=true

# ============ Режим сканирования ============
TIMEFRAME=D
SCAN_INTERVAL=3600
MIN_TURNOVER_24H=1000000
LOOKBACK_BARS=100
MIN_PROBABILITY=0.45

# ============ Периоды анализа ============
ANALYSIS_PERIOD=60
VOLUME_LOOKBACK=20
OBV_LOOKBACK=30
BB_PERIOD=20
BB_DEV=2.0
RSI_PERIOD=14
SMART_MONEY_LOOKBACK=7

# ============ Пороги ============
RANGE_MAX=0.25
RANGE_MIN=0.05
VOLUME_SPIKE=2.0
BB_COMPRESSION=0.7
MIN_VOLUME_USD=1000000
MIN_TRADES=10000
MAX_SPREAD=0.003
MIN_DAYS_LISTED=90
MAX_PRICE=1.0

# ============ Фильтры шума ============
MAX_VOLATILITY_3D=0.10
MAX_DROP_7D=0.30
MIN_PUMP_PROBABILITY=0.45

# ============ Веса факторов (сумма = 1.0) ============
WEIGHT_RANGE=0.15
WEIGHT_VOLUME=0.20
WEIGHT_OBV=0.15
WEIGHT_BB=0.10
WEIGHT_SMART_MONEY=0.15
WEIGHT_OUTFLOW=0.10
WEIGHT_RSI=0.05
WEIGHT_LIQUIDITY=0.10

# ============ Исключения ============
EXCLUDE_SYMBOLS=BTCUSDT,ETHUSDT,BNBUSDT,SOLUSDT,XRPUSDT,DOGEUSDT,ADAUSDT,AVAXUSDT,DOTUSDT,LINKUSDT
