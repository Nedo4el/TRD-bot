# ============================================================
# Бот: Адаптивная стратегия от волатильности.
# SMA200 задаёт направление, вход по EMA5/13,
# стопы считаются от ATR(14): SL=1.5*ATR, TP=2.5*ATR.
# ============================================================

# ============ Bybit API ключи ============
BYBIT_API_KEY=your_api_key_here
BYBIT_API_SECRET=your_api_secret_here
# Тестовая сеть (true = testnet, false = mainnet)
TESTNET=true

# Режим симуляции: true - бот НЕ отправляет реальные ордера,
# только логирует, что бы сделал. Безопасно для отладки.
SIMULATION_MODE=true

# Рыночная категория: linear (USDT-фьючерсы) | spot
CATEGORY=linear

# Торговая пара
SYMBOL=XRPUSDT

# Таймфрейм свечей: 1 | 5 | 15 | 60 | 240 | D
TIMEFRAME=5

# Интервал проверки сигналов (секунды)
POLL_INTERVAL=60

# Сколько свечей запрашивать для расчёта индикаторов
KLINE_LIMIT=400

# Максимум REST-запросов в секунду (защита от лимитов Bybit)
REQUESTS_PER_SECOND=10

# ============ Риск-менеджмент ============
# Размер позиции в % от доступного баланса
POSITION_PCT=10.0

# Фиксированный размер лота в базовом активе.
# 0 = выключено (размер считается от POSITION_PCT).
FIXED_QTY=0

# Стоп-лосс и тейк-профит в % от цены входа.
# ВНИМАНИЕ: для этого бота НЕ используются! Стопы считает сама стратегия от ATR.
STOP_LOSS_PCT=2.0
TAKE_PROFIT_PCT=4.0

# ============ WebSocket ============
WS_ENABLED=true

# ============ Telegram уведомления ============
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ============ Логирование ============
LOG_LEVEL=INFO
LOG_FILE=logs/adaptive.log
STATE_FILE=data/state_adaptive.json

# ============ Параметры стратегии Adaptive ============
# Период SMA большого тренда (выше - только покупки, ниже - продажи)
SMA_TREND_PERIOD=200

# Периоды EMA для точки входа
EMA_FAST_PERIOD=5
EMA_SLOW_PERIOD=13

# ATR: период и множители стопов (SL = ATR_SL_MULT * ATR и т.д.)
ATR_PERIOD=14
ATR_SL_MULT=1.5
ATR_TP_MULT=2.5

# Сколько последних свечей считать "средней волатильностью за день"
# (1440 свечей = сутки на таймфрейме M1). Если текущий ATR выше -
# рынок шумный, сигналы пропускаются.
ATR_AVG_LOOKBACK=1440

# Минимальный ATR в % от цены: ниже - спред съест прибыль, не входим
MIN_ATR_PCT=0.1
