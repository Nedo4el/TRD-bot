# ============================================================
# Бот: Уровни (пробой + ретест)
# ============================================================

# ============ Bybit API ключи ============
BYBIT_API_KEY=YOUR_API_KEY
BYBIT_API_SECRET=YOUR_API_SECRET
# Тестовая сеть (true = testnet, false = mainnet)
TESTNET=true

# Режим симуляции: true - ордера НЕ отправляются, только логи.
SIMULATION_MODE=false

# Рыночная категория: linear (USDT-фьючерсы) | spot
CATEGORY=linear

# Торговая пара
SYMBOL=XRPUSDT

# Таймфрейм свечей: 1 | 5 | 15 | 60 | 240 | D
TIMEFRAME=5

# Интервал проверки сигналов (секунды)
POLL_INTERVAL=30

# Сколько свечей запрашивать для расчёта индикаторов
KLINE_LIMIT=200

# Максимум REST-запросов в секунду (защита от лимитов Bybit)
REQUESTS_PER_SECOND=10

# ============ Риск-менеджмент ============
# Размер позиции в % от доступного баланса
POSITION_PCT=10.0

# Фиксированный размер лота в базовом активе.
# 0 = выключено (размер считается от POSITION_PCT).
FIXED_QTY=0

# Стоп-лосс и тейк-профит в % от цены входа.
STOP_LOSS_PCT=0.2
TAKE_PROFIT_PCT=0.4

# ============ WebSocket ============
WS_ENABLED=true

# ============ Telegram уведомления ============
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ============ Логирование ============
LOG_LEVEL=INFO
LOG_FILE=logs/yrovni.log
STATE_FILE=data/state_yrovni.json

# ============ Параметры стратегии ============
# TODO: добавить параметры после написания стратегии
