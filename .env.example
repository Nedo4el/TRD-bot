# ============ Bybit API ключи ============
# Получить: testnet.bybit.com/app/user/api-management (testnet)
#           bybit.com/app/user/api-management (mainnet)
BYBIT_API_KEY=your_api_key_here
BYBIT_API_SECRET=your_api_secret_here

# Тестовая сеть (true = testnet, false = mainnet)
TESTNET=true

# Режим симуляции: true — бот НЕ отправляет реальные ордера,
# только логирует, что бы сделал. Безопасно для отладки.
SIMULATION_MODE=true

# ============ Торговые параметры ============
# Рыночная категория: linear (USDT-фьючерсы) | spot
CATEGORY=linear

# ====== ИНСТРУМЕНТ: впишите сюда пару для торговли ======
# Примеры: ETHUSDT, SOLUSDT, XRPUSDT, DOGEUSDT (фьючерсы USDT-M)
SYMBOL=

# Таймфрейм свечей: 1 | 5 | 15 | 60 | 240 | D (1m, 5m, ... 1d)
TIMEFRAME=15

# Периоды скользящих средних (быстрая / медленная)
FAST_MA_PERIOD=7
SLOW_MA_PERIOD=25

# Интервал проверки сигналов (секунды)
POLL_INTERVAL=60

# Сколько свечей запрашивать для расчёта индикаторов
KLINE_LIMIT=200

# Максимум REST-запросов в секунду (защита от лимитов Bybit)
REQUESTS_PER_SECOND=10

# ============ Риск-менеджмент ============
# Размер позиции в % от доступного баланса
POSITION_PCT=10.0

# Стоп-лосс в % от цены входа
STOP_LOSS_PCT=2.0

# Тейк-профит в % от цены входа
TAKE_PROFIT_PCT=4.0

# ============ WebSocket ============
# Подписываться ли на реальный поток цен
WS_ENABLED=true

# ============ Telegram уведомления ============
# Необязательно. Оставьте пустым, чтобы отключить.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ============ Логирование ============
LOG_LEVEL=INFO
LOG_FILE=logs/bot.log

# Файл состояния (позиции и ордера для восстановления после рестарта)
STATE_FILE=data/state.json