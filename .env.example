# ============================================================
# ОБЩИЙ .env (fallback). Каждый бот в первую очередь читает
# СВОЙ файл: bot_sma/.env, bot_combo/.env и т.д.
# Этот файл используется только backtest.py и как запасной вариант.
# ============================================================

BYBIT_API_KEY=your_api_key_here
BYBIT_API_SECRET=your_api_secret_here

TESTNET=true

# Режим симуляции: true — ордера не отправляются, только логируются
SIMULATION_MODE=true

CATEGORY=linear
SYMBOL=XRPUSDT

TIMEFRAME=15
POLL_INTERVAL=60
KLINE_LIMIT=200
REQUESTS_PER_SECOND=10

POSITION_PCT=10.0
# Фиксированный лот (0 = считать от POSITION_PCT)
FIXED_QTY=0

STOP_LOSS_PCT=2.0
TAKE_PROFIT_PCT=4.0

WS_ENABLED=true

TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

LOG_LEVEL=INFO
LOG_FILE=logs/bot.log
STATE_FILE=data/state.json
