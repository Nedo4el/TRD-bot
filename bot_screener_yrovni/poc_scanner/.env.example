# POC-скринер: параметры (копировать в poc_scanner/.env или bot_screener_yrovni/.env)

# --- Окна и профиль -----------------------------------------------------
# Окна через запятую, формат <дни>d. До 30d считаются по 1h, длиннее — по 4h.
POC_WINDOWS=3d,5d,7d,14d,30d,180d,365d,730d
POC_BINS=100
VA_PERCENT=0.68

# --- Пороги объёма (USD) ------------------------------------------------
CONFIRM_VOLUME_THRESHOLD=50000000
MIN_SIGNAL_VOLUME=10000000
WALL_VOLUME_THRESHOLD=200000000

# --- Зоны и слияние -----------------------------------------------------
TOUCH_PROXIMITY_PCT=0.005
MERGE_POC_PCT=0.01
MIN_CONFIDENCE=0.6

# --- Возраст уровней ----------------------------------------------------
MIN_POC_AGE_DAYS=7
MAX_POC_AGE_DAYS=730

# --- Хранение -----------------------------------------------------------
POC_HISTORY_DB=data/poc_history.sqlite
HISTORY_CACHE_DAYS=730
POC_LEVELS_LOG=logs/poc_levels.jsonl
POC_SIGNALS_LOG=logs/poc_signals.jsonl

# --- Сигналы роботу -----------------------------------------------------
SIGNAL_ENDPOINT=http://127.0.0.1:8787/api/signal
SIGNAL_TIMEOUT_SEC=5
TOUCH_COOLDOWN_SEC=3600
SIGNAL_COOLDOWN_SEC=3600
ATR_PERIOD=14

# --- Символы по умолчанию (если не переданы аргументами) ----------------
POC_SYMBOLS=SOLUSDT
