# POC-скринер: параметры (копировать в poc_scanner/.env или bot_screener_yrovni/.env)

# --- Окна и профиль -----------------------------------------------------
# Окна через запятую, формат <дни>d. До 30d считаются по 1h, длиннее — по 4h.
POC_WINDOWS=3d,5d,7d,14d,30d,180d,365d,730d
POC_BINS=100
VA_PERCENT=0.68
# Узлы объёма (HVN): кроме POC храним до PROFILE_NODES локальных максимумов
# профиля с объёмом не ниже NODE_MIN_SHARE от объёма POC-корзины.
# Метка уровня — <окно>#<ранг> (30d#3 — третий по объёму узел 30d).
# PROFILE_NODES=0 — только POC.
PROFILE_NODES=6
NODE_MIN_SHARE=0.35

# --- Пороги объёма (USD) ------------------------------------------------
CONFIRM_VOLUME_THRESHOLD=50000000
MIN_SIGNAL_VOLUME=10000000
WALL_VOLUME_THRESHOLD=200000000

# --- Кластеры и зона сигнала (модель «ближайший кластер») ----------------
# Уровни ближе CLUSTER_MERGE_PCT друг к другу сливаются в кластер
# (|A-B|/min(A,B), транзитивно), торговый уровень — среднее цен.
# Сигнал — когда цена входит в ZONE_PCT зону ближайшего кластера.
CLUSTER_MERGE_PCT=0.05
ZONE_PCT=0.15
# Сильный сигнал: цена не подходила к уровню ZONE_QUIET_HOURS часов,
# а вход в зону случился не раньше ZONE_FRESH_HOURS часов назад.
ZONE_QUIET_HOURS=24
ZONE_FRESH_HOURS=2
# Фильтр «цена уходила от уровня»: 0 = выключен (уровень участвует всегда).
# 0.20 = уровень в сигналах только если цена отходила от него на 20 % внутри
# его окна — так отсекается свежий POC текущей зоны (7d/14d у цены).
MIN_DEPARTURE_PCT=0
# Уровень не участвует в сигналах, если цена касалась его (low..high свечи)
# за последние TOUCH_LOOKBACK_HOURS часов. 0 = фильтр выключен.
TOUCH_LOOKBACK_HOURS=48
# Цена для сравнения — закрытая свеча этого интервала (POC — на 1h/4h).
PRICE_INTERVAL=5

# --- Слияние уровней в БД (до кластеризации) ----------------------------
MERGE_POC_PCT=0.01

# --- Устаревшие пороги (модель кластеров их не использует) --------------
TOUCH_PROXIMITY_PCT=0.005
MIN_CONFIDENCE=0.6

# --- Исторические отрезки (старые объёмные уровни) ----------------------
# calendar_month — POC по календарным месяцам, fixed_30d — блоками по 30 дней,
# off — выключено. Rolling-окна считаются всегда.
SEGMENT_MODE=calendar_month
TOP_N_SEGMENTS=12
SEGMENT_MIN_VOLUME_USD=10000000

# --- Возраст уровней ----------------------------------------------------
MIN_POC_AGE_DAYS=7
MAX_POC_AGE_DAYS=730

# --- Хранение -----------------------------------------------------------
POC_HISTORY_DB=data/poc_history.sqlite
HISTORY_CACHE_DAYS=730
POC_LEVELS_LOG=logs/poc_levels.jsonl
POC_SIGNALS_LOG=logs/poc_signals.jsonl

# --- Сигналы в дашборд (приёмник POST /api/signal) ----------------------
SIGNAL_ENDPOINT=http://127.0.0.1:8787/api/signal
SIGNAL_TIMEOUT_SEC=5
# Кулдауны и ATR моделью кластеров не используются (оставлены для совместимости)
TOUCH_COOLDOWN_SEC=3600
SIGNAL_COOLDOWN_SEC=3600
ATR_PERIOD=14

# --- Дополнительные символы (сверх рынка из дашборда) -------------------
# Дашборд сканирует весь рынок по панели «Все монеты» (оборот, число монет,
# исключения) и всегда добавляет эти символы. main.py берёт только этот список.
POC_SYMBOLS=SOLUSDT
