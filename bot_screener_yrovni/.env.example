# ============================================================
# Volume Profile скринер — Bybit USDT-M фьючерсы
# ============================================================

# ============ Bybit API ключи ============
BYBIT_API_KEY=YOUR_API_KEY
BYBIT_API_SECRET=YOUR_API_SECRET
TESTNET=true

# ============ Режим сканирования ============
SCAN_INTERVAL=300
MIN_TURNOVER_24H=50000000
LOOKBACK_BARS=500
PROXIMITY_PCT=10.0

# ============ Исключения (топ-15) ============
EXCLUDE_SYMBOLS=BTCUSDT,ETHUSDT,BNBUSDT,SOLUSDT,XRPUSDT,DOGEUSDT,ADAUSDT,AVAXUSDT,DOTUSDT,LINKUSDT,MATICUSDT,UNIUSDT,SHIBUSDT,LTCUSDT,ATOMUSDT
